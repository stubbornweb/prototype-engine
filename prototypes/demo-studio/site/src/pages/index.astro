---
const title = 'Prototype Experience';
const description = 'A fast, motion-first prototype generated with the Prototype Engine.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <main class="hero">
      <p class="eyebrow">Prototype Engine</p>
      <h1>Make the idea visible.</h1>
      <p class="lede">Replace this starter with the experience described in EXPERIENCE.md.</p>
      <a href="#next" class="cta">Explore</a>
    </main>
    <section id="next" class="next">
      <p>Build the smallest set of sections that makes the concept memorable.</p>
    </section>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; min-height: 100vh; background: #0a0a0a; color: #f5f5f5; font-family: system-ui, sans-serif; }
  .hero, .next { min-height: 100svh; display: grid; align-content: center; padding: clamp(2rem, 6vw, 8rem); }
  .hero { gap: 1rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: .18em; font-size: .75rem; opacity: .65; }
  h1 { max-width: 10ch; margin: 0; font-size: clamp(4rem, 11vw, 11rem); line-height: .86; letter-spacing: -.06em; }
  .lede { max-width: 34rem; font-size: clamp(1rem, 1.8vw, 1.35rem); opacity: .7; }
  .cta { width: fit-content; padding: .9rem 1.2rem; border: 1px solid #666; border-radius: 999px; color: inherit; text-decoration: none; }
  .next { background: #f5f5f5; color: #0a0a0a; }
  .next p { max-width: 18ch; font-size: clamp(3rem, 8vw, 8rem); line-height: .95; letter-spacing: -.05em; }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }
</style>
